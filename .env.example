# Leave blank for a local SQLite file at backend/inkvoid.db.
# For Neon, paste the PostgreSQL connection string from the Neon dashboard.
DATABASE_URL=

# Generate a unique private value before deployment.
SECRET_KEY=
ENVIRONMENT=development

# Comma-separated frontend origins for production, e.g. https://inkvoid.onrender.com
CORS_ORIGINS=*

# ONEID API used to link an authenticated INKVOID account.
ONEID_API_URL=http://127.0.0.1:8000

# Neon Object Storage (keep these values server-side only).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=ap-southeast-1
NEON_STORAGE_BUCKET=inkvoid-images
